{
  "name": "segmenthl7tools",
  "version": "2.0.2",
  "description": "Ferramentas para manipulação de segmentos HL7",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:cov": "vitest --coverage --run",
    "test:coverage": "vitest --coverage --run",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "prepare": "husky",
    "biome:format": "npx @biomejs/biome format --write ./src",
    "biome:format:check": "npx @biomejs/biome format ./src",
    "biome:lint": "npx @biomejs/biome lint ./src",
    "biome:check": "npx @biomejs/biome check ./src"
  },
  "keywords": [
    "hl7",
    "segment",
    "healthcare",
    "medical",
    "interoperability",
    "segmenthl7tools"
  ],
  "author": "ICeranto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorceranto/segmentHL7Tools.git"
  },
  "bugs": {
    "url": "https://github.com/igorceranto/segmentHL7Tools/issues"
  },
  "homepage": "https://github.com/igorceranto/segmentHL7Tools#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "4.1.8",
    "husky": "9.1.7",
    "release-it": "20.0.1",
    "tsup": "8.5.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
